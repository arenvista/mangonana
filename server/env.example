# Gmail (used by the /contact route)
EMAIL_USER=
EMAIL_PASS=
CONTACT_TO_EMAIL=

# Stripe (used by /create-checkout-session and /webhook)
# Secret key: Stripe Dashboard -> Developers -> API keys (use a test key while developing)
STRIPE_SECRET_KEY=
# Webhook signing secret: printed by `stripe listen --forward-to localhost:5000/webhook`
# in development, or from Dashboard -> Developers -> Webhooks in production
STRIPE_WEBHOOK_SECRET=

# Base URL of the Astro site, used to build the Stripe success/cancel redirect URLs
CLIENT_URL=http://localhost:4321

PORT=5000
