---
---

<section class="connect section" id="connect">
  <div class="container connect-grid">
    <div class="connect-copy" data-reveal="left">
      <p class="eyebrow">Say hi</p>
      <h2>Questions, commissions, or capybara emergencies.</h2>
      <p class="connect-sub">
        Not ready to order yet? Ask us anything — sizing, shipping timelines,
        whether we can sculpt your D&amp;D character (yes).
      </p>
    </div>

    <form id="contact-form" class="connect-form" data-reveal="right" novalidate>
      <div class="form-row">
        <label class="field">
          <span>First name</span>
          <input type="text" name="firstName" autocomplete="given-name" />
        </label>
        <label class="field">
          <span>Last name</span>
          <input type="text" name="lastName" autocomplete="family-name" />
        </label>
      </div>
      <label class="field">
        <span>Email *</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="field">
        <span>Phone</span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
      <label class="field">
        <span>Message *</span>
        <textarea name="message" rows="5" required></textarea>
      </label>

      <button type="submit" class="btn btn-primary connect-submit">
        <span>Send message</span>
      </button>
      <p id="contact-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .connect { background: var(--paper); }
  .connect-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }
  .connect-copy h2 { margin-top: 16px; font-size: clamp(1.8rem, 4vw, 2.6rem); max-width: 20ch; }
  .connect-sub { margin-top: 16px; color: var(--ink-2); max-width: 44ch; }

  .connect-form {
    background: var(--card);
    border: 2px solid var(--slate);
    border-radius: var(--radius-lg);
    box-shadow: 8px 8px 0 var(--peach);
    padding: clamp(26px, 4vw, 42px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field > span {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .connect-submit { justify-content: center; }
  #contact-status { min-height: 1.3em; font-size: 0.9rem; }

  @media (min-width: 900px) { .connect-grid { grid-template-columns: 1fr 1.1fr; } }
  @media (max-width: 560px) { .form-row { grid-template-columns: 1fr; } }
</style>

<script>
  const API_BASE = "http://localhost:5000";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("contact-status")!;
  const submitBtn = form.querySelector<HTMLButtonElement>(".connect-submit")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());

    if (!String(data.email).trim() || !String(data.message).trim()) {
      status.textContent = "Please add your email and a message.";
      status.className = "form-danger";
      return;
    }

    submitBtn.disabled = true;
    submitBtn.querySelector("span")!.textContent = "Sending...";
    status.textContent = "";
    status.className = "";

    try {
      const res = await fetch(`${API_BASE}/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json;charset=utf-8" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error();
      status.textContent = "Sent! We'll get back to you soon.";
      status.className = "form-success";
      form.reset();
    } catch {
      status.textContent = "Could not send right now — please try again in a minute.";
      status.className = "form-danger";
    } finally {
      submitBtn.disabled = false;
      submitBtn.querySelector("span")!.textContent = "Send message";
    }
  });
</script>
