---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <svg class="footer-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,35 C260,65 520,5 780,30 C1040,55 1240,10 1440,35 L1440,60 L0,60 Z" fill="#24414A" />
  </svg>

  <div class="footer-body">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="brand-mark">M</span>
        <span>Mangonanas Miniatures</span>
      </div>

      <nav class="footer-links" aria-label="Footer">
        <a href="/#home">Home</a>
        <a href="/catalog">Catalog</a>
        <a href="/custom-order">Custom order</a>
        <a href="/checkout">Cart</a>
        <a href="/#process">Process</a>
        <a href="/#connect">Connect</a>
      </nav>

      <div class="footer-social">
        <a href="https://www.linkedin.com/in/aren-vista-079199203/" aria-label="LinkedIn">in</a>
        <a href="https://github.com/arenvista" aria-label="GitHub">gh</a>
        <a href="https://gitlab.com/arenvista" aria-label="GitLab">gl</a>
      </div>
    </div>

    <div class="container footer-bottom">
      <p>© {currentYear} Mangonanas Miniatures. Sculpted with clay, caffeine, and questionable posture.</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--paper); }
  .footer-wave { display: block; width: 100%; height: clamp(28px, 4vw, 60px); }

  .footer-body {
    background: var(--slate-deep);
    color: var(--paper);
    padding-block: 46px 26px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(251, 244, 232, 0.16);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 46% 54% 52% 48% / 50% 46% 54% 50%;
    background: var(--peach);
    color: var(--slate);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  .footer-links { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 0.92rem; opacity: 0.9; }
  .footer-links a {
    position: relative;
    transition: color var(--dur-1) var(--ease-out);
  }
  .footer-links a:hover { color: var(--peach); }

  .footer-social { display: flex; gap: 10px; }
  .footer-social a {
    width: 40px;
    height: 40px;
    border-radius: 46% 54% 52% 48% / 50% 46% 54% 50%;
    border: 2px solid rgba(251, 244, 232, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    text-transform: uppercase;
    transition: background-color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-squash), color var(--dur-1) var(--ease-out);
  }
  .footer-social a:hover {
    background: var(--peach);
    border-color: var(--peach);
    color: var(--slate);
    transform: rotate(-8deg) scale(1.1);
  }

  .footer-bottom { padding-top: 22px; font-size: 0.82rem; opacity: 0.65; }

  @media (min-width: 800px) {
    .footer-inner { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
