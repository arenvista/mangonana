<section class="hero" id="home">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Handmade in polymer clay</p>

      <h1 class="hero-title" aria-label="Tiny sculptures, big personality.">
        <span class="line"><span class="line-inner">Tiny sculptures,</span></span>
        <span class="line"><span class="line-inner"><em class="marker">big</em> personality.</span></span>
      </h1>

      <p class="hero-sub">
        Pokémon, Studio Ghibli spirits, capybaras, and anything else you can
        photograph — sculpted by hand, one of one, and shipped to your desk.
      </p>

      <div class="hero-actions">
        <a href="/catalog" class="btn btn-primary">Browse the catalog <span class="arrow">→</span></a>
        <a href="/custom-order" class="btn btn-ghost">Start a custom order</a>
      </div>
    </div>

    <div class="hero-scene" aria-hidden="true">
      <!-- Signature: the clay mascot. Morphing blob + blinking eyes. -->
      <div class="blob blob-main">
        <span class="eye eye-l"></span>
        <span class="eye eye-r"></span>
        <span class="cheek cheek-l"></span>
        <span class="cheek cheek-r"></span>
        <span class="smile"></span>
      </div>
      <div class="blob blob-rose"></div>
      <div class="blob blob-teal"></div>

      <span class="mini mini-star">✦</span>
      <span class="mini mini-heart">♥</span>
      <span class="mini mini-dot"></span>

      <!-- Rotating circular badge -->
      <div class="badge-spin">
        <svg viewBox="0 0 120 120" width="118" height="118">
          <defs>
            <path id="badge-circle" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" />
          </defs>
          <text>
            <textPath href="#badge-circle">handmade with clay • one of one • handmade with clay •</textPath>
          </text>
        </svg>
        <span class="badge-center">✋</span>
      </div>
    </div>
  </div>

  <!-- Wave into the marquee below -->
  <svg class="hero-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,40 C240,75 480,5 720,35 C960,65 1200,10 1440,40 L1440,70 L0,70 Z" fill="#30525C" />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(130px, 16vw, 180px);
    background:
      radial-gradient(55% 65% at 82% 18%, var(--peach-tint) 0%, transparent 70%),
      radial-gradient(45% 55% at 8% 85%, var(--powder-light) 0%, transparent 70%),
      var(--paper);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    padding-bottom: clamp(90px, 12vw, 140px);
  }

  /* --- Headline: staggered squash-pop line reveal ------------------------ */
  .hero-title {
    margin-top: 24px;
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    font-weight: 800;
  }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .line-inner {
    display: inline-block;
    transform: translateY(115%);
    animation: line-up 0.8s var(--ease-squash) forwards;
  }
  .line:nth-child(2) .line-inner { animation-delay: 0.14s; }
  @keyframes line-up {
    to { transform: translateY(0); }
  }

  /* "big" gets a hand-drawn peach marker swipe behind it */
  .marker {
    position: relative;
    font-style: normal;
    color: var(--teal);
    white-space: nowrap;
  }
  .marker::before {
    content: "";
    position: absolute;
    inset: 12% -6% 4% -6%;
    background: var(--peach);
    border-radius: 10px 16px 12px 18px;
    transform: rotate(-2deg) scaleX(0);
    transform-origin: left center;
    animation: marker-swipe 0.5s var(--ease-out) 0.75s forwards;
    z-index: -1;
  }
  @keyframes marker-swipe {
    to { transform: rotate(-2deg) scaleX(1); }
  }

  .hero-sub {
    margin-top: 22px;
    max-width: 46ch;
    color: var(--ink-2);
    font-size: 1.1rem;
    opacity: 0;
    animation: fade-rise 0.7s var(--ease-out) 0.45s forwards;
  }
  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    opacity: 0;
    animation: fade-rise 0.7s var(--ease-out) 0.6s forwards;
  }
  @keyframes fade-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- Scene: morphing clay blobs ---------------------------------------- */
  .hero-scene {
    position: relative;
    min-height: 340px;
  }

  .blob {
    position: absolute;
    animation: blob-morph 9s ease-in-out infinite, float-y 7s ease-in-out infinite;
  }
  .blob-main {
    width: min(300px, 62vw);
    aspect-ratio: 1;
    background: var(--peach);
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    box-shadow: inset -14px -18px 0 rgba(211, 150, 166, 0.35); /* clay under-shade */
    animation-delay: 0s, 0.4s;
  }
  .blob-rose {
    width: 110px;
    aspect-ratio: 1;
    background: var(--rose);
    left: 4%;
    top: 8%;
    animation-duration: 11s, 8.5s;
  }
  .blob-teal {
    width: 78px;
    aspect-ratio: 1;
    background: var(--teal);
    right: 4%;
    bottom: 4%;
    animation-duration: 10s, 6s;
    animation-delay: 1s, 1s;
  }

  /* The face: two blinking eyes, cheeks, a stitched smile */
  .eye {
    position: absolute;
    top: 40%;
    width: 13px;
    height: 20px;
    border-radius: 999px;
    background: var(--slate);
    animation: blink 4.4s ease-in-out infinite;
    transform-origin: center;
  }
  .eye-l { left: 36%; }
  .eye-r { right: 36%; animation-delay: 0.05s; }
  .cheek {
    position: absolute;
    top: 52%;
    width: 22px;
    height: 12px;
    border-radius: 50%;
    background: var(--rose);
    opacity: 0.65;
  }
  .cheek-l { left: 24%; }
  .cheek-r { right: 24%; }
  .smile {
    position: absolute;
    top: 52%;
    left: 50%;
    translate: -50%;
    width: 34px;
    height: 18px;
    border: 4px solid var(--slate);
    border-top: none;
    border-radius: 0 0 999px 999px;
  }

  /* Confetti minis drifting around the mascot */
  .mini {
    position: absolute;
    font-size: 1.5rem;
    animation: float-y 5s ease-in-out infinite, wiggle 4s ease-in-out infinite;
  }
  .mini-star { color: var(--teal); left: 12%; bottom: 14%; animation-delay: 0.6s, 0s; }
  .mini-heart { color: var(--rose); right: 14%; top: 10%; font-size: 1.2rem; animation-delay: 1.4s, 0.8s; }
  .mini-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--steel);
    right: 30%;
    top: 24%;
    animation-delay: 2s, 0.4s;
  }

  /* --- Rotating badge ----------------------------------------------------- */
  .badge-spin {
    position: absolute;
    right: 6%;
    bottom: 26%;
    width: 118px;
    height: 118px;
    display: grid;
    place-items: center;
  }
  .badge-spin svg {
    position: absolute;
    inset: 0;
    animation: spin-slow 22s linear infinite;
  }
  .badge-spin:hover svg { animation-play-state: paused; }
  .badge-spin text {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--slate);
  }
  .badge-center { font-size: 1.6rem; }

  /* --- Wave divider -------------------------------------------------------- */
  .hero-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(34px, 5vw, 70px);
  }

  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.1fr 1fr; }
    .hero-scene { min-height: 460px; }
  }
  @media (max-width: 899px) {
    .badge-spin { right: 0; bottom: 8%; scale: 0.85; }
  }

  @media (prefers-reduced-motion: reduce) {
    .line-inner { transform: none; animation: none; }
    .marker::before { transform: rotate(-2deg) scaleX(1); animation: none; }
    .hero-sub, .hero-actions { opacity: 1; animation: none; }
  }
</style>
