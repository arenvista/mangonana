---
---

<section class="photobook">
  <div class="container photobook-inner">
    <div class="photobook-copy" data-reveal="left">
      <p class="eyebrow">Photobook printing</p>
      <h2>
        Print your <em>photobook</em> — weddings, family albums, travel
        diaries, art portfolios.
      </h2>
      <p class="photobook-sub">
        Premium glossy photo paper, hardcover binding, gallery-grade colour.
        The kind of book you hand down — not the kind you keep in a folder on
        your phone.
      </p>

      <div class="photobook-actions">
        <a href="#connect" class="btn btn-primary">Quote my photobook</a>
        <a href="#connect" class="btn btn-ghost">See samples</a>
      </div>

      <div class="trust-row">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>390+ five-star reviews</span>
        <span class="dot">•</span>
        <span>~3 min to get a quote</span>
      </div>
    </div>

    <div class="photobook-art" data-reveal="right">
      <div class="art-plate" data-parallax="0.08"></div>
    </div>
  </div>
</section>

<style>
  .photobook { background: var(--paper-3); }

  .photobook-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  .photobook-copy h2 {
    margin-top: 16px;
    font-size: clamp(2rem, 4.6vw, 3.2rem);
  }
  .photobook-copy em {
    font-style: italic;
    color: var(--plum);
  }

  .photobook-sub {
    margin-top: 20px;
    max-width: 46ch;
    color: var(--ink-2);
    line-height: 1.7;
  }

  .photobook-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .trust-row {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .stars { color: var(--gold); letter-spacing: 2px; }
  .dot { color: var(--line-2); }

  .photobook-art { display: flex; justify-content: center; }

  .art-plate {
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1.1;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, #5c3865 0%, #2c1533 100%);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 960px) {
    .photobook-inner { grid-template-columns: 1fr 1fr; }
  }
</style>
