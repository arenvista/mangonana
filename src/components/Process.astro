---
const steps = [
  {
    n: "01",
    color: "peach",
    title: "Pick or upload",
    copy: "Choose a piece from the catalog, or send us a reference photo for something completely custom. Screenshots, fan art, photos of your actual pet — all fair game.",
  },
  {
    n: "02",
    color: "powder",
    title: "We sculpt & send previews",
    copy: "Your miniature is blocked out in polymer clay, refined, and baked. For custom orders you get progress photos before anything is final — tweaks are part of the deal.",
  },
  {
    n: "03",
    color: "rose",
    title: "Paint, seal, detail",
    copy: "Layered acrylics, matte or gloss sealant, and the tiny details that make it feel alive: blush cheeks, glazed scales, stitched smiles.",
  },
  {
    n: "04",
    color: "teal",
    title: "Packed & shipped",
    copy: "Foam-nested and double-boxed with tracking. Keychain hardware or gift wrap added if you chose them at checkout. Then it's on your desk.",
  },
];
---

<section class="process section" id="process">
  <div class="container">
    <div class="process-head" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2>From photo to shelf in four steps.</h2>
    </div>

    <!-- Each panel is sticky: as you scroll, the next slides up and stacks
         over the previous like cards being dealt. -->
    <div class="stack">
      {steps.map((s, i) => (
        <article class={`stack-card is-${s.color}`} style={`--i:${i}`}>
          <span class="stack-num">{s.n}</span>
          <div class="stack-body">
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </div>
          <span class="stack-blob" aria-hidden="true"></span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process { background: var(--paper); }
  .process-head h2 { margin-top: 16px; font-size: clamp(1.8rem, 4vw, 2.8rem); }

  .stack {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .stack-card {
    position: sticky;
    /* each card parks slightly lower than the previous → visible stack */
    top: calc(96px + var(--i) * 18px);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    align-items: start;
    min-height: 250px;
    padding: clamp(28px, 4vw, 46px);
    border: 2px solid var(--slate);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 -10px 30px -18px rgba(48, 82, 92, 0.35);
  }
  .is-peach  { background: var(--peach); }
  .is-powder { background: var(--powder); }
  .is-rose   { background: var(--rose); }
  .is-teal   { background: var(--teal); color: #fff; }
  .is-teal .stack-num { color: rgba(255, 255, 255, 0.85); }
  .is-teal p { color: rgba(255, 255, 255, 0.92); }

  .stack-num {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    color: var(--slate);
    opacity: 0.85;
  }
  .stack-body h3 { font-size: clamp(1.3rem, 2.6vw, 1.8rem); }
  .stack-body p { margin-top: 12px; max-width: 58ch; color: var(--slate-deep); font-size: 1rem; }

  /* soft blob peeking from each panel's corner */
  .stack-blob {
    position: absolute;
    right: -60px;
    bottom: -70px;
    width: 190px;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.35);
    animation: blob-morph 10s ease-in-out infinite;
  }

  .stack-card { position: sticky; }

  @media (max-width: 700px) {
    .stack-card { grid-template-columns: 1fr; }
  }
</style>
