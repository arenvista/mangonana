---
const reviews = [
  { quote: "The Totoro on my monitor stand gets more compliments than the monitor.", name: "Maya R.", tag: "Ghibli set" },
  { quote: "Sent one blurry photo of my cat. Got back my cat, but 5cm tall and smug.", name: "Devon K.", tag: "Custom order" },
  { quote: "The keychain has survived two years on my house keys. Zero chips.", name: "Priya S.", tag: "Keychain mount" },
  { quote: "Gift-wrapped capybara for my sister. She cried. 10/10.", name: "Jon A.", tag: "Gift wrap" },
  { quote: "Charizard's tail flame is translucent. HOW. It glows by the window.", name: "Lena M.", tag: "Catalog piece" },
  { quote: "Progress photos at every step — felt like watching it hatch.", name: "Sam T.", tag: "Custom order" },
];
---

<section class="reviews section">
  <div class="container reviews-head" data-reveal>
    <p class="eyebrow">From the shelf owners</p>
    <h2>Read the room(s) they live in.</h2>
  </div>

  <!-- Two counter-drifting rows of review cards; hover to pause and read -->
  <div class="rev-rows">
    {[false, true].map((reverse) => (
      <div class={`rev-viewport${reverse ? " is-reverse" : ""}`}>
        <div class="rev-track">
          {[0, 1].map(() => (
            <div class="rev-run" aria-hidden={undefined}>
              {reviews.map((r) => (
                <figure class="rev-card">
                  <blockquote>“{r.quote}”</blockquote>
                  <figcaption>
                    <strong>{r.name}</strong>
                    <span class="rev-tag">{r.tag}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .reviews { background: var(--powder-light); overflow: hidden; }
  .reviews-head h2 { margin-top: 16px; font-size: clamp(1.8rem, 4vw, 2.8rem); }

  .rev-rows { margin-top: 44px; display: flex; flex-direction: column; gap: 20px; }
  .rev-viewport { overflow: hidden; }

  .rev-track {
    display: flex;
    width: max-content;
    animation: marquee-x 48s linear infinite;
  }
  .is-reverse .rev-track { animation-direction: reverse; animation-duration: 56s; }
  .rev-viewport:hover .rev-track { animation-play-state: paused; }

  .rev-run { display: flex; gap: 20px; padding-right: 20px; }

  .rev-card {
    width: 330px;
    flex-shrink: 0;
    background: var(--card);
    border: 2px solid var(--slate);
    border-radius: var(--radius-md);
    padding: 24px 26px;
    box-shadow: 4px 4px 0 var(--slate);
    transition: transform var(--dur-1) var(--ease-squash);
  }
  .rev-card:hover { transform: translateY(-4px) rotate(-0.6deg); }

  .rev-card blockquote { font-size: 0.98rem; line-height: 1.55; color: var(--ink-2); }
  .rev-card figcaption {
    margin-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .rev-card strong { font-family: var(--display); }
  .rev-tag {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--teal-tint);
    color: var(--teal-dark);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }
</style>
