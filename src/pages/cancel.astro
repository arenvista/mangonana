---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Checkout cancelled — Mangonanas Miniatures" description="Your checkout was cancelled and no payment was made.">
  <Nav />
  <main>
    <section class="confirm section">
      <div class="container confirm-inner" data-reveal="scale">
        <p class="eyebrow">Checkout cancelled</p>
        <h1>No worries — nothing was charged.</h1>
        <p class="confirm-copy">
          Your checkout was cancelled before payment, so your card was never
          charged. Your selections weren't saved — head back to the order
          page whenever you're ready to try again.
        </p>
        <a href="/checkout" class="btn btn-primary">Back to order page</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .confirm {
    padding-top: clamp(150px, 20vw, 200px);
    min-height: 55vh;
    display: flex;
    align-items: center;
  }
  .confirm-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }
  .confirm h1 { margin-top: 10px; font-size: clamp(1.9rem, 4vw, 2.6rem); }
  .confirm-copy {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }
  .confirm .btn { margin-top: 30px; }
</style>
