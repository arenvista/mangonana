---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { CATALOG, CATEGORY_LABELS } from "../lib/catalog";

const categories = ["all", "pokemon", "ghibli", "other"] as const;
---

<Layout title="Catalog — Mangonanas Miniatures" description="Browse ready-to-order Pokémon, Studio Ghibli, and original custom sculptures.">
  <Nav />
  <main>
    <section class="catalog-hero">
      <div class="container">
        <p class="eyebrow">Browse catalog</p>
        <h1>Pick a model, pick a size.</h1>
        <p class="catalog-sub">
          These are ready-to-order designs we've already sculpted patterns
          for. Choose a size, add it to your cart, and choose Keychain or
          Gift Wrap options at checkout.
        </p>
      </div>
    </section>

    <section class="catalog section">
      <div class="container">
        <div class="tabs" role="tablist" aria-label="Catalog categories">
          {categories.map((c) => (
            <button
              type="button"
              class="tab"
              role="tab"
              data-category={c}
              aria-selected={c === "all" ? "true" : "false"}
            >
              {c === "all" ? "All" : CATEGORY_LABELS[c]}
            </button>
          ))}
        </div>

        <div class="catalog-grid" id="catalog-grid" data-reveal-group="catalog-grid">
          {CATALOG.map((item, i) => (
            <div
              class={`catalog-card tone-${item.tone}`}
              data-reveal="scale"
              data-category={item.category}
              style={`--reveal-delay:${(i % 6) * 70}ms`}
            >
              <div class="card-photo">
                <span class="photo-badge">{CATEGORY_LABELS[item.category]}</span>
              </div>
              <div class="card-body">
                <h3>{item.name}</h3>
                <p>{item.blurb}</p>

                <div class="card-controls">
                  <label class="size-select-wrap">
                    <span class="size-label">Size</span>
                    <select class="size-select" data-item-id={item.id} data-base-price={item.basePrice}>
                      <option value="Small">Small</option>
                      <option value="Medium">Medium</option>
                      <option value="Large">Large</option>
                    </select>
                  </label>
                  <span class="card-price" data-price-for={item.id}></span>
                </div>

                <button type="button" class="btn btn-primary card-add" data-item-id={item.id}>
                  <span>Add to cart</span>
                </button>
              </div>
            </div>
          ))}
        </div>

        <p id="no-results" class="no-results" hidden>No pieces in this category yet — try Custom Order below.</p>
      </div>
    </section>

    <section class="custom-callout">
      <div class="container custom-callout-inner" data-reveal>
        <div>
          <p class="eyebrow">Can't find it here?</p>
          <h2>Send us a photo and we'll sculpt it from scratch.</h2>
          <p class="custom-copy">
            Upload a reference image and we'll follow up by email with a
            custom quote within 1–3 business days — no payment required to
            ask.
          </p>
        </div>
        <a href="/custom-order" class="btn btn-primary">Start a custom order →</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .catalog-hero {
    padding-top: clamp(140px, 18vw, 190px);
    padding-bottom: 20px;
    background:
      radial-gradient(60% 60% at 85% 10%, var(--plum-tint) 0%, transparent 70%),
      var(--paper);
  }
  .catalog-hero h1 { margin-top: 12px; font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .catalog-sub { margin-top: 16px; max-width: 56ch; color: var(--muted); font-size: 1.05rem; line-height: 1.65; }

  .catalog { background: var(--paper); }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }
  .tab {
    padding: 10px 20px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--paper);
    transition: background-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }
  .tab[aria-selected="true"] {
    background: var(--plum);
    color: var(--paper);
    border-color: var(--plum);
  }
  .tab:not([aria-selected="true"]):hover { background: var(--plum-tint); }

  .catalog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .catalog-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-1) var(--ease-out), box-shadow var(--dur-1) var(--ease-out), opacity var(--dur-1) var(--ease-out);
  }
  .catalog-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .catalog-card.is-hidden { display: none; }

  .card-photo {
    height: 180px;
    display: flex;
    align-items: flex-start;
    padding: 16px;
  }
  .tone-1 .card-photo { background: linear-gradient(155deg, #5c3164, #3a1c40); }
  .tone-2 .card-photo { background: linear-gradient(155deg, #ab7f34, #7a5a22); }
  .tone-3 .card-photo { background: linear-gradient(155deg, #756b5e, #3a3530); }

  .photo-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--paper);
    background: rgba(28, 26, 23, 0.35);
    padding: 5px 12px;
    border-radius: 999px;
  }

  .card-body { padding: 22px; }
  .card-body h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .card-body p { color: var(--muted); font-size: 0.9rem; line-height: 1.55; min-height: 2.7em; }

  .card-controls {
    margin-top: 16px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .size-select-wrap { display: flex; flex-direction: column; gap: 6px; }
  .size-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .size-select {
    border: 1px solid var(--line-2);
    border-radius: 10px;
    padding: 8px 12px;
    background: var(--paper);
  }

  .card-price {
    font-family: var(--serif);
    font-size: 1.2rem;
    color: var(--plum);
    display: inline-block;
  }
  .card-price.tick { animation: price-tick 0.35s var(--ease-out); }
  @keyframes price-tick {
    0% { transform: translateY(0); opacity: 1; }
    40% { transform: translateY(-4px); opacity: 0.4; }
    100% { transform: translateY(0); opacity: 1; }
  }

  .card-add { width: 100%; justify-content: center; margin-top: 18px; }
  /* Quick success pulse when a piece lands in the cart */
  .card-add.added {
    background: var(--gold);
    border-color: var(--gold);
    animation: add-pulse 0.45s var(--ease-out);
  }
  @keyframes add-pulse {
    0% { transform: scale(1); }
    35% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-add.added, .card-price.tick { animation: none; }
  }

  .no-results {
    margin-top: 30px;
    text-align: center;
    color: var(--muted);
  }

  .custom-callout { background: var(--paper-3); }
  .custom-callout-inner {
    padding-block: clamp(48px, 7vw, 90px);
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  .custom-callout-inner h2 { margin-top: 10px; font-size: clamp(1.6rem, 3.2vw, 2.3rem); max-width: 24ch; }
  .custom-copy { margin-top: 12px; max-width: 50ch; color: var(--muted); }

  @media (min-width: 640px) {
    .catalog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .catalog-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 800px) {
    .custom-callout-inner { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>

<script>
  import { SIZE_DELTAS, formatPrice, type Size } from "../lib/catalog";
  import { addToCart } from "../lib/cart";

  // --- price display, updates as size changes ---
  const selects = Array.from(document.querySelectorAll<HTMLSelectElement>(".size-select"));

  function updatePrice(select: HTMLSelectElement, animate = false) {
    const base = parseInt(select.dataset.basePrice ?? "0", 10);
    const size = select.value as Size;
    const total = base + (SIZE_DELTAS[size] ?? 0);
    const priceEl = document.querySelector<HTMLElement>(`[data-price-for="${select.dataset.itemId}"]`);
    if (!priceEl) return;
    priceEl.textContent = formatPrice(total);
    if (animate) {
      priceEl.classList.remove("tick");
      void priceEl.offsetWidth;
      priceEl.classList.add("tick");
    }
  }

  selects.forEach((select) => {
    updatePrice(select);
    select.addEventListener("change", () => updatePrice(select, true));
  });

  // --- add to cart ---
  document.querySelectorAll<HTMLButtonElement>(".card-add").forEach((btn) => {
    btn.addEventListener("click", () => {
      const itemId = btn.dataset.itemId!;
      const select = document.querySelector<HTMLSelectElement>(`.size-select[data-item-id="${itemId}"]`)!;
      addToCart(itemId, select.value as Size, 1);

      const span = btn.querySelector("span")!;
      const original = span.textContent;
      span.textContent = "Added ✓";
      btn.disabled = true;
      btn.classList.add("added");
      window.setTimeout(() => {
        span.textContent = original;
        btn.disabled = false;
        btn.classList.remove("added");
      }, 1100);
    });
  });

  // --- category tabs ---
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".tab"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".catalog-card"));
  const noResults = document.getElementById("no-results")!;

  function applyFilter(category: string) {
    let visibleCount = 0;
    cards.forEach((card) => {
      const matches = category === "all" || card.dataset.category === category;
      card.classList.toggle("is-hidden", !matches);
      if (matches) visibleCount += 1;
    });
    noResults.hidden = visibleCount > 0;
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
      tab.setAttribute("aria-selected", "true");
      applyFilter(tab.dataset.category ?? "all");
    });
  });
</script>
