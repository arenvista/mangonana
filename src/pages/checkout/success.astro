---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Order confirmed — Mangonanas Miniatures" description="Your order and payment were received.">
  <Nav />
  <main>
    <section class="confirm section">
      <div class="container confirm-inner" data-reveal="scale">
        <span class="confirm-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="30" height="30" fill="none">
            <path
              class="check-path"
              d="M7 17 L13.5 23.5 L25 9.5"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <p class="eyebrow">Payment confirmed</p>
        <h1>Thank you — your order is in!</h1>
        <p class="confirm-copy">
          Stripe has verified your payment and a receipt is on its way to
          your inbox. We'll follow up by email shortly with next steps for
          sending over your reference photos and details.
        </p>
        <p class="confirm-ref" id="session-ref"></p>
        <a href="/" class="btn btn-primary">Back to home</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .confirm {
    padding-top: clamp(150px, 20vw, 200px);
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .confirm-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }
  .confirm-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--plum-soft);
    color: var(--plum);
    margin-bottom: 20px;
    animation: icon-pop 0.6s var(--ease-out) 0.15s backwards;
  }
  /* The checkmark draws itself in once the page settles */
  .check-path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: check-draw 0.5s var(--ease-out) 0.45s forwards;
  }
  @keyframes icon-pop {
    from { transform: scale(0.5); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @keyframes check-draw {
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .confirm-icon { animation: none; }
    .check-path { animation: none; stroke-dashoffset: 0; }
  }

  .confirm h1 { margin-top: 10px; font-size: clamp(1.9rem, 4vw, 2.6rem); }
  .confirm-copy {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }
  .confirm-ref {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    word-break: break-all;
  }
  .confirm .btn { margin-top: 30px; }
</style>

<script>
  import { clearCart } from "../../lib/cart";

  // The purchase went through — empty the local cart so the customer doesn't
  // return to /checkout with an already-paid order still sitting in it.
  clearCart();

  // Purely cosmetic: shows the Checkout Session id from the redirect URL as an
  // order reference. This does NOT confirm payment on its own — the webhook
  // handler in server/index.mjs is the verified, server-side source of truth
  // for whether the order was actually paid.
  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get("session_id");
  const ref = document.getElementById("session-ref");
  if (ref && sessionId) {
    ref.textContent = `Order reference: ${sessionId}`;
  }
</script>
