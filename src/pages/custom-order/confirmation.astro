---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Request received — Mangonanas Miniatures" description="Your custom order request was received.">
  <Nav />
  <main>
    <section class="confirm section">
      <div class="container confirm-inner" data-reveal="scale">
        <span class="confirm-icon" aria-hidden="true">✓</span>
        <p class="eyebrow">Request received</p>
        <h1>Got it — check your inbox soon.</h1>
        <p class="confirm-copy">
          We received your reference photo and details. Our sculptor will
          review it and email you a custom quote within
          <strong>1–3 business days</strong>. No payment is needed until you
          decide to go ahead.
        </p>
        <div class="confirm-actions">
          <a href="/catalog" class="btn btn-ghost">Browse the catalog</a>
          <a href="/" class="btn btn-primary">Back to home</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .confirm {
    padding-top: clamp(150px, 20vw, 200px);
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .confirm-inner { max-width: 580px; margin-inline: auto; text-align: center; }
  .confirm-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--plum-soft);
    color: var(--plum);
    font-size: 1.6rem;
    margin-bottom: 20px;
  }
  .confirm h1 { margin-top: 10px; font-size: clamp(1.9rem, 4vw, 2.6rem); }
  .confirm-copy { margin-top: 16px; color: var(--muted); font-size: 1.02rem; line-height: 1.65; }
  .confirm-copy strong { color: var(--plum); }
  .confirm-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
</style>
